# Пул выполнения Celery worker.
# Основные варианты: prefork, threads, solo.
WORKER_POOL=prefork

# Число одновременно выполняемых задач в одном worker.
CONCURRENCY=2

# Очереди, которые слушает worker. Несколько очередей разделяются запятыми.
QUEUES=default,long,short

# Брокер сообщений: redis или rabbit.
BROKER=redis

# Хранилище результатов выполнения задач.
RESULT_BACKEND=redis://redis:6379/2

# Подтверждать задачу после выполнения, а не перед запуском.
CELERY_ACKS_LATE=true

# Вернуть задачу в очередь при аварийной остановке дочернего процесса worker.
CELERY_REJECT_ON_WORKER_LOST=true

# Время в секундах, после которого неподтверждённая Redis-задача доступна повторно.
VISIBILITY_TIMEOUT=30

# Число задач, заранее забираемых каждым процессом worker.
PREFETCH_MULTIPLIER=1

# Мягкий лимит выполнения задачи в секундах. none отключает лимит.
SOFT_TIME_LIMIT=none

# Жёсткий лимит выполнения задачи в секундах. none отключает лимит.
TIME_LIMIT=none

# Redis-хранилище для эксперимента write_once.
WRITE_ONCE_REDIS_URL=redis://redis:6379/1

# Задержка в секундах после SETNX в эксперименте write_once.
WRITE_ONCE_POST_SETNX_DELAY=0
